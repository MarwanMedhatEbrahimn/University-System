# Prisma database connection (SQLite by default)
DATABASE_URL=file:./dev.db

# Secret used to sign the express-session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-here

# Port the server listens on (defaults to 8000 if omitted)
PORT=8000
